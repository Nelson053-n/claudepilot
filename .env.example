# claudepilot — конфигурация / configuration
# Скопируй в .env и заполни. Copy to .env and fill in.

# Bearer-токен для мутирующих запросов (POST/PUT/PATCH/DELETE).
# Если пусто — сгенерируется и сохранится в settings при первом старте.
# Bearer token for mutating requests. If empty, one is generated on first start.
PROF_TOKEN=

# Хост/порт. 0.0.0.0 откроет дашборд в локальной сети (см. README → Security).
# Host/port. 0.0.0.0 exposes the dashboard on the LAN (see README → Security).
PROF_HOST=127.0.0.1
PROF_PORT=7777

# Безопасный hot-reload по файлу runs/.reload-trigger. 0 — выключить.
# Safe hot-reload via runs/.reload-trigger. 0 to disable.
PROF_RELOAD=1

# Telegram-уведомления (опционально; имеют приоритет над settings в БД).
# Telegram notifications (optional; take precedence over the DB settings).
# PROF_TG_BOT_TOKEN=
# PROF_TG_CHAT_ID=
